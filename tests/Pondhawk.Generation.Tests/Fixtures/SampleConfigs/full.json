{
    "$schema": "./pondhawk.project.schema.json",
    "ProjectName": "catalog",
    "Description": "Catalog data layer",
    "OutputDir": "src/Generated",
    "Templates": {
        "entity": {
            "Path": "templates/entity.generated.liquid",
            "OutputPattern": "Entities/{{ item.Name | pascal_case }}.generated.cs",
            "Scope": "PerItem",
            "Mode": "Always",
            "AppliesTo": "Class"
        },
        "entity-stub": {
            "Path": "templates/entity.stub.liquid",
            "OutputPattern": "Entities/{{ item.Name | pascal_case }}.cs",
            "Scope": "PerItem",
            "Mode": "SkipExisting",
            "AppliesTo": "Class"
        },
        "registry": {
            "Path": "templates/registry.liquid",
            "OutputPattern": "Registry.g.cs",
            "Scope": "Single",
            "Mode": "Always"
        }
    },
    "Values": {
        "Namespace": "Catalog.Data",
        "Retries": 3,
        "Strict": true
    },
    "Overrides": [
        { "Path": "*/CreatedAt", "Artifact": "entity", "Variant": "AuditTimestamp" },
        { "Path": "Product/Price", "Artifact": "entity", "Variant": "Currency" },
        { "Path": "Order/**", "Artifact": "entity", "Metadata": { "Access": "internal" } },
        { "Path": "*/Secret", "Ignore": true }
    ],
    "Logging": {
        "Enabled": true,
        "LogPath": ".pondhawk/logs/pondhawk.log",
        "Level": "Debug",
        "RollingInterval": "Day",
        "RetainedFileCountLimit": 7
    }
}
